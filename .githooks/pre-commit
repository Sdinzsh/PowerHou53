#!/bin/sh
# PowerHous3 pre-commit hook — HARD gate for the closed learning loop.
#
# Evaluates the STAGED index (what the commit records), not the worktree, so a
# commit cannot slip over-cap content past the gate by shrinking the file after
# `git add`. Blocks on memory-cap overflow and missing bounded-memory files.
# Graph artifacts / changelog liveness / drift are warnings by default (see
# scripts/loop_check.py); promote them with --require-graph/--strict-* here.
#
# Degrades safely: if no Python 3 interpreter is found, the hook warns and
# allows the commit rather than blocking all work on a Python-less machine.
# Bypass explicitly with LOOP_CHECK_SKIP=1 or `git commit --no-verify`.
set -eu

ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/scripts/loop_check.py"

[ -f "$CHECK" ] || exit 0   # nothing to enforce

PY=""
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "[pre-commit] WARNING: no Python interpreter found; skipping loop-check." >&2
  exit 0
fi

# --staged: gate the index.  Extra args ($@) let you add --strict-* locally.
exec "$PY" "$CHECK" --staged "$@"
